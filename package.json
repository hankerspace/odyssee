    "check": "npm run build:web && npm run test:rust",
    "test": "npm run check",
    "test:frontend": "npm run build:web",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "setup:runtime": "node scripts/prepare-local-runtime.mjs",
    "paths:runtime": "node scripts/print-runtime-paths.mjs",
    "generate": "npm run build:web",
    "package": "npm run build:desktop",
    "deploy:local": "npm run package"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
